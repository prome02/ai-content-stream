# Example environment file (safe to commit)
# Copy to .env.local and edit values as needed.

# Firebase (use Emulator-friendly dummy values by default)
# Note: Firebase SDK validates API key format; it must look like "AIzaSy..." even for Emulator.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyForEmulatorUseOnly
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcd1234
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCD1234

# Firebase Emulator (recommended for local development)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# AI generation mode
# true  => use mock data, no LLM required
# false => call Ollama (Cloud or Local)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b-cloud

# Ollama Cloud (uncomment when using Cloud)
# OLLAMA_API_KEY=your_ollama_cloud_api_key
